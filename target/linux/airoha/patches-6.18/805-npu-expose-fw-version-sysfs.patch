From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt Builder
Date: Mon, 3 Aug 2026 08:00:00 +0000
Subject: [PATCH] airoha_npu: expose firmware version via sysfs attribute

The NPU firmware version is queried from the running NPU firmware via a
mailbox message during probe (and logged as "NPU fw version: %d.%d"),
but it is not exposed to userspace.

Add a `fw_version` struct member to cache the value and expose it via a
sysfs attribute so userspace tools (e.g. LuCI RPC backend) can reliably
read the running NPU firmware version without scraping dmesg.

Signed-off-by: OpenWrt Builder
---
 drivers/net/ethernet/airoha/airoha_npu.c  | 39 ++++++++++++++++++++++-
 include/linux/soc/airoha/airoha_offload.h |  1 +
 2 files changed, 39 insertions(+), 1 deletion(-)

--- a/include/linux/soc/airoha/airoha_offload.h
+++ b/include/linux/soc/airoha/airoha_offload.h
@@ -166,6 +166,7 @@
 struct airoha_npu {
 #if (IS_BUILTIN(CONFIG_NET_AIROHA_NPU) || IS_MODULE(CONFIG_NET_AIROHA_NPU))
 	struct device *dev;
+	u32 fw_version;
 	struct regmap *regmap;
 
 	struct airoha_npu_core {
--- a/drivers/net/ethernet/airoha/airoha_npu.c
+++ b/drivers/net/ethernet/airoha/airoha_npu.c
@@ -793,8 +793,11 @@
 
 	if (!airoha_npu_wlan_msg_get(npu, 0, WLAN_FUNC_GET_WAIT_NPU_VERSION,
 				     &val, sizeof(val), GFP_KERNEL))
-		dev_info(dev, "NPU fw version: %0d.%d\n",
-			 (val >> 16) & 0xffff, val & 0xffff);
+	{
+		npu->fw_version = val;
+		dev_info(dev, "NPU fw version: %0d.%d\n",
+			 (val >> 16) & 0xffff, val & 0xffff);
+	}
 
 	platform_set_drvdata(pdev, npu);
 
@@ -802,19 +805,50 @@
 }
 
+static ssize_t fw_version_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct airoha_npu *npu = dev_get_drvdata(dev);
+	u16 major, minor;
+
+	if (!npu || !npu->fw_version)
+		return sysfs_emit(buf, "unknown\n");
+
+	major = (npu->fw_version >> 16) & 0xffff;
+	minor = npu->fw_version & 0xffff;
+
+	return sysfs_emit(buf, "%u.%u\n", major, minor);
+}
+static DEVICE_ATTR_RO(fw_version);
+
+static ssize_t num_cores_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", NPU_NUM_CORES);
+}
+static DEVICE_ATTR_RO(num_cores);
+
+static struct attribute *airoha_npu_attrs[] = {
+	&dev_attr_fw_version.attr,
+	&dev_attr_num_cores.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(airoha_npu);
+
 static void airoha_npu_remove(struct platform_device *pdev)
 {
 	struct airoha_npu *npu = platform_get_drvdata(pdev);
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(npu->cores); i++)
 		cancel_work_sync(&npu->cores[i].wdt_work);
 }
 
 static struct platform_driver airoha_npu_driver = {
 	.probe = airoha_npu_probe,
 	.remove = airoha_npu_remove,
 	.driver = {
+		.dev_groups = airoha_npu_groups,
 		.name = "airoha-npu",
 		.of_match_table = of_airoha_npu_match,
 	},
 };
