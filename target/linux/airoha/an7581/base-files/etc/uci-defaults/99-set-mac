#!/bin/sh
#
# Assign derived MAC addresses for Airoha AN7581 based devices.
# Run once on first boot via uci-defaults.
#

. /lib/functions.sh

BOARD=$(board_name)
case "$BOARD" in
	nokia,xg-040g-md|\
	nokia,xg-040g-md-ubi)
		# Get base MAC from gdm1 (LAN) interface
		BASE_MAC=""
		for i in $(seq 1 30); do
			BASE_MAC=$(cat /sys/class/net/dsa-mgr/address 2>/dev/null)
			if [ -n "$BASE_MAC" ] && [ "$BASE_MAC" != "00:00:00:00:00:00" ]; then
				break
			fi
			sleep 1
		done

		if [ -z "$BASE_MAC" ] || [ "$BASE_MAC" = "00:00:00:00:00:00" ]; then
			logger -t "set-mac" "Failed to get base MAC"
			exit 0
		fi

		logger -t "set-mac" "Base MAC: $BASE_MAC"

		# Derive WAN MAC (base + 1)
		OIFS="$IFS"
		IFS=":"
		set -- $BASE_MAC
		B1=$1; B2=$2; B3=$3; B4=$4; B5=$5; B6=$6
		IFS="$OIFS"

		L4=$((0x$B4))
		L5=$((0x$B5))
		L6=$((0x$B6))

		# Add 1 to last octet for WAN
		L6=$((L6 + 1))
		if [ $L6 -gt 255 ]; then
			L5=$((L5 + 1))
			L6=0
		fi
		if [ $L5 -gt 255 ]; then
			L4=$((L4 + 1))
			L5=0
		fi

		WAN_MAC=$(printf "%s:%s:%s:%02x:%02x:%02x" "$B1" "$B2" "$B3" "$L4" "$L5" "$L6")

		logger -t "set-mac" "Setting WAN MAC to $WAN_MAC"

		# Configure in UCI for persistence
		uci set network.wan.macaddr="$WAN_MAC"
		uci commit network

		# Apply immediately if interface exists
		if [ -d /sys/class/net/wan ]; then
			ip link set dev wan address "$WAN_MAC" 2>/dev/null
		fi

		# Self-remove after first run
		rm -f /etc/uci-defaults/99-set-mac
		;;
esac

exit 0
