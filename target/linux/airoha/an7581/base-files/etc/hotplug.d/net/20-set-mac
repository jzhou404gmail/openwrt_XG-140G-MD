#!/bin/sh
#
# Assign derived MAC addresses for Airoha AN7581 based devices.
# The base MAC is read from the gdm1 (LAN) interface (from NVMEM).
# Other interfaces get derived MACs (base + N).
#

. /lib/functions.sh

get_base_mac() {
	local mac=""
	local tries=0

	while [ $tries -lt 30 ]; do
		mac=$(cat /sys/class/net/dsa-mgr/address 2>/dev/null)
		if [ -n "$mac" ] && [ "$mac" != "00:00:00:00:00:00" ]; then
			echo "$mac"
			return 0
		fi
		tries=$((tries + 1))
		sleep 1
	done
	return 1
}

derive_mac() {
	local base="$1"
	local offset="$2"
	local b1 b2 b3 b4 b5 b6
	local o1 o2 o3 o4 o5 o6

	b1=$(echo "$base" | cut -d: -f1)
	b2=$(echo "$base" | cut -d: -f2)
	b3=$(echo "$base" | cut -d: -f3)
	b4=$(echo "$base" | cut -d: -f4)
	b5=$(echo "$base" | cut -d: -f5)
	b6=$(echo "$base" | cut -d: -f6)

	# Convert last 3 bytes to decimal, add offset, convert back
	local l4=$((0x$b4))
	local l5=$((0x$b5))
	local l6=$((0x$b6))

	# Add offset to last octet, handle carry
	l6=$((l6 + offset))
	if [ $l6 -gt 255 ]; then
		l5=$((l5 + l6 / 256))
		l6=$((l6 % 256))
	fi
	if [ $l5 -gt 255 ]; then
		l4=$((l4 + l5 / 256))
		l5=$((l5 % 256))
	fi
	l4=$((l4 % 256))

	printf "%02x:%02x:%02x:%02x:%02x:%02x" \
		"$b1" "$b2" "$b3" \
		"$(printf '%02x' $l4)" \
		"$(printf '%02x' $l5)" \
		"$(printf '%02x' $l6)"
}

base_mac=$(get_base_mac)
if [ -z "$base_mac" ]; then
	logger -t "set-mac" "Failed to get base MAC address"
	exit 1
fi

logger -t "set-mac" "Base MAC: $base_mac"

# Set WAN MAC (gdm4) to base + 1
wan_mac=$(derive_mac "$base_mac" 1)
if [ -n "$wan_mac" ]; then
	logger -t "set-mac" "Setting WAN MAC to $wan_mac"
	ip link set dev wan address "$wan_mac" 2>/dev/null
	# Also set in UCI config for persistence
	uci set network.wan.macaddr="$wan_mac"
	uci commit network
fi

exit 0
